# Run before every build; preserve the header mtime when provenance is unchanged.
# This works for Git checkouts, worktrees (.git file), and source archives.
if(NOT DEFINED SEGA_SOURCE_DIR OR NOT DEFINED SEGA_OUTPUT_FILE)
    message(FATAL_ERROR "SEGA_SOURCE_DIR and SEGA_OUTPUT_FILE are required")
endif()

function(sega_revision directory result)
    set(revision "unknown")
    # Prevent git from walking upward and attributing an archive/absent submodule
    # to a containing repository.
    if(EXISTS "${directory}/.git")
        execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${directory}"
            RESULT_VARIABLE head_status OUTPUT_VARIABLE head
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(head_status EQUAL 0 AND NOT head STREQUAL "")
            set(revision "${head}")
            execute_process(COMMAND git status --porcelain --untracked-files=normal
                WORKING_DIRECTORY "${directory}" RESULT_VARIABLE status_status
                OUTPUT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if(NOT status_status EQUAL 0)
                string(APPEND revision "-worktree-state-unknown")
            elseif(NOT status STREQUAL "")
                string(APPEND revision "-dirty")
            endif()
        endif()
    endif()
    set(${result} "${revision}" PARENT_SCOPE)
endfunction()
sega_revision("${SEGA_SOURCE_DIR}" SEGA_REVISION)
sega_revision("${SEGA_SOURCE_DIR}/libs/megahit" SEGA_MEGAHIT_REVISION)

# Include source locations in the digest, so renames and additions are visible.
# Paths are relative and sorted, giving the same digest after relocating a copy.
set(source_files "${SEGA_SOURCE_DIR}/CMakeLists.txt")
file(GLOB_RECURSE cmake_files LIST_DIRECTORIES false "${SEGA_SOURCE_DIR}/cmake/*.cmake")
list(APPEND source_files ${cmake_files})
foreach(directory include backends bench libs/megahit/src libs/sdsl-lite/include libs/sdsl-lite/lib)
    file(GLOB_RECURSE candidates LIST_DIRECTORIES false "${SEGA_SOURCE_DIR}/${directory}/*")
    foreach(candidate IN LISTS candidates)
        if(candidate MATCHES "\\.(h|hpp|hh|hxx|c|cc|cpp|cxx|ipp|inl|tpp)$")
            list(APPEND source_files "${candidate}")
        endif()
    endforeach()
endforeach()
list(REMOVE_DUPLICATES source_files)
list(SORT source_files)
set(manifest "SEGA-BUILD-SOURCE-v1\n")
foreach(source IN LISTS source_files)
    file(RELATIVE_PATH relative "${SEGA_SOURCE_DIR}" "${source}")
    file(SHA256 "${source}" digest)
    string(APPEND manifest "${relative} ${digest}\n")
endforeach()
string(SHA256 SEGA_SOURCE_SHA256 "${manifest}")

function(sega_cpp_string input result)
    string(REPLACE "\\" "\\\\" value "${input}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    set(${result} "\"${value}\"" PARENT_SCOPE)
endfunction()
set(header "// Generated at build time; do not edit.\n#pragma once\n")
foreach(name SEGA_REVISION SEGA_MEGAHIT_REVISION SEGA_SOURCE_SHA256 SEGA_BUILD_FLAGS)
    sega_cpp_string("${${name}}" encoded)
    string(APPEND header "#define ${name} ${encoded}\n")
endforeach()
get_filename_component(output_dir "${SEGA_OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
set(previous "")
if(EXISTS "${SEGA_OUTPUT_FILE}")
    file(READ "${SEGA_OUTPUT_FILE}" previous)
endif()
if(NOT previous STREQUAL header)
    file(WRITE "${SEGA_OUTPUT_FILE}" "${header}")
endif()
